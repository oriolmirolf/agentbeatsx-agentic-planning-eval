# --- PATHS ---
# Path to the PDDL validation binary (VAL)
# In Docker, this is usually /usr/local/bin/Validate
VAL_PATH=./green_agent/VAL/bin/Validate

# Path to the directory containing PDDL domains and problems
EXAMPLES_DIR=./examples

# --- NETWORK CONFIGURATION (A2A) ---
# The URL where the Green Agent (Evaluator) is reachable
# For local Docker networking, use http://green:8000
GREEN_AGENT_URL=http://localhost:8000

# The URL where the Purple Agent (Planner) is reachable
# For local Docker networking, use http://purple:8001
PURPLE_AGENT_URL=http://localhost:8001

# --- LOGGING ---
# Set to DEBUG to see full PDDL-to-NL translation traces
LOG_LEVEL=INFO

# --- TOKEN TRACKING (Optional) ---
# If using LLM backends for Purple Agents, ensure these are reported
# as input_tokens and output_tokens in the final evaluation JSON.